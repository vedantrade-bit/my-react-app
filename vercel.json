{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "create-react-app"
    },
    "expense-tracker": {
      "root": "expense-tracker",
      "framework": "create-react-app"
    },
    "backend": {
      "root": "expense-tracker/backend",
      "framework": "express",
      "bindings": [
        {
          "type": "service",
          "service": "web-dashboard",
          "format": "url",
          "env": "WEB_DASHBOARD_URL"
        }
      ]
    },
    "web-dashboard": {
      "root": "web-dashboard",
      "framework": "express",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
